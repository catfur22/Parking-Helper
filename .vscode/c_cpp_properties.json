{
    "configurations": [
        {
            "name": "Arduino Uno",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:HOME}/Arduino/libraries/Adafruit_NeoPixel",
                "${env:HOME}/Arduino/libraries/OneWire",
                "${env:HOME}/Arduino/libraries/DallasTemperature",
                "${env:HOME}/.arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino",
                "${env:HOME}/.arduino15/packages/arduino/hardware/avr/1.8.8/variants/standard"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_AVR_UNO",
                "ARDUINO_ARCH_AVR",
                "F_CPU=16000000L"
            ],
            "compilerPath": "${env:HOME}/.arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++",
            "compilerArgs": [
                "-mmcu=atmega328p"
            ],
            "cStandard": "c17",
            "cppStandard": "gnu++11",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
